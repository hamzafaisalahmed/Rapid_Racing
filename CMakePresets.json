{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "mingw-debug",
            "displayName": "MinGW Debug",
            "description": "Debug build using g++ (MinGW) — no optimisation, debug symbols included",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "mingw-release",
            "displayName": "MinGW Release",
            "description": "Optimised release build using g++ (MinGW)",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Build Debug",
            "configurePreset": "mingw-debug"
        },
        {
            "name": "release",
            "displayName": "Build Release",
            "configurePreset": "mingw-release"
        }
    ]
}